# salvorbench — local environment. Copy to `.env` (git-ignored) and fill in.
# NEVER commit .env. `.gitignore` enforces this; `salvorbench verify` re-asserts it.

# REQUIRED — a real Anthropic API key (sk-ant-api03-...).
# An OAuth/subscription token is explicitly rejected by preflight: it is short-lived
# and would expire mid-run, turning every later unit into an auth failure.
ANTHROPIC_API_KEY=

# OPTIONAL — HuggingFace read token (free; https://huggingface.co/settings/tokens).
# CooperBench pulls its dataset from HuggingFace. The dataset is public, so this
# only raises rate limits during a long run. Preflight warns if absent, never fails.
HF_TOKEN=
